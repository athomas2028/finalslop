}

.ai-text-easy {
  border-left-color: #ffaa00;
  color: #ffd480;
}

.chat-bubble {
  background-color: rgba(44, 44, 66, 0.5);
  border-radius: 12px;
  padding: 15px;
  margin: 15px 0;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.chat-user {
  border-left: 3px solid #4da6ff;
}

.chat-friend {
  border-left: 3px solid #ff8e53;
}

.highlight {
  color: #ff5555;
  font-weight: bold;
}

