:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=JetBrains+Mono:wght@400;700&display=swap');

#ui-bar {
  display: none;
}

#story {
  margin-left: 0 !important;
  padding: 0;
}

body {
  background: radial-gradient(circle at center, #111122 0%, #07070b 100%);
  color: #e2e8f0;
  font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  margin: 0;
  padding: 20px;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  background: rgba(22, 22, 33, 0.75);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5);
  border-radius: 16px;
  max-width: 680px;
  width: 100%;
  margin: 40px auto;
  padding: 40px;
  box-sizing: border-box;
  animation: fadeIn 0.8s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

h1, h2, h3 {
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-top: 0;
}

h1 {
  font-size: 2.2em;
  text-align: center;
  background: linear-gradient(135deg, #ffffff 30%, #a5b4fc 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 15px;
  margin-bottom: 25px;
}

h2 {
  font-size: 1.8em;
  background: linear-gradient(135deg, #81c784 30%, #4da6ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 20px;
}

h2.highlight {
  background: linear-gradient(135deg, #ff6b6b 30%, #ff8e53 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 20px;
}

p {
  font-size: 1.1em;
  line-height: 1.7;
  color: #cbd5e1;
}

.btn {
  display: block;
  width: 100%;
  padding: 16px 24px;
  margin: 16px auto;
  background: linear-gradient(135deg, rgba(77, 166, 255, 0.12) 0%, rgba(77, 166, 255, 0.04) 100%);
  color: #8ab4f8;
  border: 1px solid rgba(138, 180, 248, 0.25);
  border-radius: 8px;
  text-decoration: none;
  text-align: center;
  font-weight: 600;
  font-size: 1.05em;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  cursor: pointer;
  box-sizing: border-box;
}

.btn:hover {
  background: linear-gradient(135deg, #4da6ff 0%, #1a73e8 100%);
  color: #ffffff !important;
  border-color: #4da6ff;
  box-shadow: 0 0 15px rgba(77, 166, 255, 0.4);
  transform: translateY(-2px);
  text-decoration: none;
}

.btn:active {
  transform: translateY(0);
}

.btn-danger {
  color: #ff8080;
  border-color: rgba(255, 128, 128, 0.25);
  background: linear-gradient(135deg, rgba(255, 85, 85, 0.12) 0%, rgba(255, 85, 85, 0.04) 100%);
}

.btn-danger:hover {
  background: linear-gradient(135deg, #ff5555 0%, #cc0000 100%);
  border-color: #ff5555;
  box-shadow: 0 0 15px rgba(255, 85, 85, 0.4);
}

.btn-success {
  color: #81c784;
  border-color: rgba(129, 199, 132, 0.25);
  background: linear-gradient(135deg, rgba(0, 204, 102, 0.12) 0%, rgba(0, 204, 102, 0.04) 100%);
}

.btn-success:hover {
  background: linear-gradient(135deg, #00cc66 0%, #00994d 100%);
  border-color: #00cc66;
  box-shadow: 0 0 15px rgba(0, 204, 102, 0.4);
}

.btn-purple {
  color: #c5a3ff;
  border-color: rgba(197, 163, 255, 0.25);
  background: linear-gradient(135deg, rgba(166, 77, 255, 0.12) 0%, rgba(166, 77, 255, 0.04) 100%);
}

.btn-purple:hover {
  background: linear-gradient(135deg, #a64dff 0%, #7300e6 100%);
  border-color: #a64dff;
  box-shadow: 0 0 15px rgba(166, 77, 255, 0.4);
}

.btn-neutral {
  color: #e2e8f0;
  border-color: rgba(255, 255, 255, 0.15);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
}

.btn-neutral:hover {
  background: linear-gradient(135deg, #5e6b7c 0%, #3e4854 100%);
  border-color: #718096;
  box-shadow: 0 0 15px rgba(255, 255, 255, 0.15);
}

.ai-text {
  background-color: rgba(18, 18, 30, 0.85);
  border-left: 4px solid #a64dff;
  border-radius: 8px;
  padding: 20px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.95em;
  margin: 25px 0;
