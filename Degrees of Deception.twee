:: StoryJavaScript [script]
window.toggleStats = function() {
  var body = document.getElementById('stats-body');
  var btn = document.getElementById('stats-toggle');
  if (body && btn) {
    var collapsed = body.classList.toggle('collapsed');
    btn.textContent = collapsed ? '+' : '−';
  }
};

window.makeDashboardDraggable = function() {
  var dash = document.getElementById('stats-dashboard');
  if (!dash) return;
  var header = dash.querySelector('.dashboard-header');
  if (!header) return;
  var isDragging = false, startX, startY, origX, origY;

  function onStart(e) {
    isDragging = true;
    var rect = dash.getBoundingClientRect();
    origX = rect.left;
    origY = rect.top;
    startX = e.clientX;
    startY = e.clientY;
    dash.style.transition = 'none';
    e.preventDefault();
  }

  function onMove(e) {
    if (!isDragging) return;
    var dx = e.clientX - startX;
    var dy = e.clientY - startY;
    dash.style.left = origX + dx + 'px';
    dash.style.top = origY + dy + 'px';
    dash.style.right = 'auto';
  }

  function onEnd() {
    if (!isDragging) return;
    isDragging = false;
    dash.style.transition = '';
  }

  header.addEventListener('mousedown', onStart);
  document.addEventListener('mousemove', onMove);
  document.addEventListener('mouseup', onEnd);
};

jQuery(document).on(':passageinit', function() {
  setTimeout(window.makeDashboardDraggable, 50);
});


:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;500&family=Inter:wght@400;700&display=swap');

body { background-color: #0d0d12; color: #d1d1e0; font-family: 'Inter', sans-serif; line-height: 1.6; }
.container { max-width: 750px; margin: 20px auto; padding: 35px; background: #16161e; border: 1px solid #2a2a3a; border-radius: 15px; }

/* Dashboard Styles */
.dashboard {
  background: #1c1c27;
  border-radius: 8px;
  border: 1px solid #333;
  position: fixed;
  top: 10px;
  right: 10px;
  z-index: 1000;
  min-width: 200px;
  max-width: 260px;
  font-size: 0.75em;
  box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  cursor: default;
  user-select: none;
}
.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 10px;
  background: #25253a;
  border-radius: 8px 8px 0 0;
  cursor: grab;
  border-bottom: 1px solid #333;
}
.dashboard-header:active { cursor: grabbing; }
.drag-handle {
  color: #666;
  font-size: 1em;
  letter-spacing: 2px;
  line-height: 1;
}
.dashboard-toggle {
  background: none;
  border: none;
  color: #888;
  cursor: pointer;
  font-size: 1em;
  padding: 0 4px;
  line-height: 1;
}
.dashboard-toggle:hover { color: #fff; }
.dashboard-body {
  padding: 8px 10px;
}
.dashboard-body.collapsed { display: none; }
.stat-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 4px;
}
.stat-row .stat-label {
  font-size: 0.7em;
  text-transform: uppercase;
  color: #888;
  min-width: 55px;
  flex-shrink: 0;
}
.meter-bg {
  background: #000;
  height: 6px;
  border-radius: 3px;
  border: 1px solid #222;
  overflow: hidden;
  position: relative;
  flex: 1;
}
.meter-fill { height: 100%; border-radius: 0; transition: width 0.8s ease-in-out; }
.muscle-color { background: #4da6ff; box-shadow: 0 0 10px rgba(77, 166, 255, 0.5); }
.integrity-color { background: #ff4d4d; box-shadow: 0 0 10px rgba(255, 77, 77, 0.5); }
.dashboard-stats {
  display: flex;
  justify-content: space-between;
  font-family: 'Fira Code', monospace;
  font-size: 0.85em;
  margin-top: 4px;
  color: #aaa;
}

/* Image Style */
.passage-img { width: 100%; height: 250px; object-fit: cover; border-radius: 10px; margin-bottom: 20px; border: 1px solid #333; display: block; }

.choice-btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 1.2em 1.5em;
  margin: 0.6em 0;
  background: #252535;
  color: #fff;
  border: 1px solid #3d3d5c;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 500;
  text-align: left;
  font-size: clamp(0.85em, 2vw, 1em);
}
.choice-btn:hover { background: #34344d; border-color: #79a1ff; transform: translateX(5px); cursor: pointer; transition: 0.2s; }
h1, h2 { font-family: 'Fira Code', monospace; color: #79a1ff; }
.success { color: #4dff88; font-weight: bold; }
.warning { color: #ff4d4d; font-weight: bold; }